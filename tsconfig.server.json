{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,
    "skipLibCheck": true,

    "types": ["node"],

    "paths": {
      "@shared/*": ["./shared/*"]
    },

    "outDir": "./dist/server",
    "sourceMap": true,
    "declaration": true
  },
  "include": ["server/**/*.ts", "shared/**/*.ts"]
}
